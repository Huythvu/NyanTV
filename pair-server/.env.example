# ── NyanTV pairing relay — environment variables ────────────────────────────
# Set these in the Vercel project (Settings → Environment Variables).

# AniList API client (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Must EXACTLY match the redirect URL registered on your AniList client, e.g.
#   https://pair.yourdomain.tld/api/pair/callback
ANILIST_REDIRECT_URI=

# MyAnimeList API app (https://myanimelist.net/apps/register), App Type "Web".
# Needed for the browser/extension "token" mode, where the relay does the token exchange server-side
# (the TV flow does not use MAL_CLIENT_SECRET — the device holds it). Add the relay callback URL as a
# redirect on the MAL app. MAL_REDIRECT_URI defaults to ANILIST_REDIRECT_URI if unset.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=

# Public base URL of THIS deployment (used to build the verify/QR link).
# Optional — falls back to the request host if unset. e.g. https://pair.yourdomain.tld
PUBLIC_BASE_URL=

# ── Storage (Firestore) ──────────────────────────────────────────────────────
# The relay stores short-lived pairing entries in Firestore (free Spark plan never archives for
# inactivity, unlike Upstash's free tier). Paste the WHOLE Firebase service-account JSON as a single
# value: Firebase console → Project settings → Service accounts → "Generate new private key".
# Keep it as one line (the private_key's \n escapes are fine — JSON.parse restores them). This is a
# secret: never commit it.
FIREBASE_SERVICE_ACCOUNT=
# Optional. Project id is normally read from the service-account JSON; set this only to override it.
FIREBASE_PROJECT_ID=
# Optional. Firestore collection for pairing entries (default: "pairing").
FIRESTORE_PAIR_COLLECTION=
